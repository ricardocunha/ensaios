{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Resultados de uma checagem de impedimento",
    "quality_profile": "showcase",
    "viewBox": [
      980,
      630
    ],
    "legend": {
      "entries": {
        "start": {
          "label": "início"
        },
        "waiting": {
          "label": "aguarda revisão"
        },
        "decision": {
          "label": "decisão"
        },
        "success": {
          "label": "veredito final"
        },
        "neutral": {
          "label": "sem veredito"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "main",
      "label": "Todo passe confirmado"
    },
    {
      "id": "review",
      "label": "Lance apertado ou incerto"
    },
    {
      "id": "terminal",
      "label": "O motor se abstém"
    }
  ],
  "states": [
    {
      "id": "pass_confirmed",
      "type": "start",
      "label": "PASS",
      "sublabel": "P para R",
      "lane": "main",
      "col": 0,
      "tag": "mesmo time",
      "width": 104
    },
    {
      "id": "offside_check",
      "type": "decision",
      "label": "OFFSIDE_CHECK",
      "sublabel": "travas · geometria",
      "tag": "rules.yaml",
      "lane": "main",
      "col": 1,
      "width": 130
    },
    {
      "id": "detected",
      "type": "success",
      "label": "DETECTED",
      "sublabel": "veredito ONSIDE ou OFFSIDE",
      "tag": "evento OFFSIDE se impedido",
      "lane": "main",
      "col": 4,
      "width": 200
    },
    {
      "id": "review_required",
      "type": "waiting",
      "label": "REVIEW_REQUIRED",
      "sublabel": "veredito ONSIDE ou OFFSIDE",
      "tag": "evento OFFSIDE se impedido · marcado",
      "lane": "review",
      "col": 2,
      "width": 200
    },
    {
      "id": "inconclusive",
      "type": "neutral",
      "label": "INCONCLUSIVE",
      "sublabel": "veredito UNKNOWN + motivo",
      "tag": "sem evento OFFSIDE",
      "lane": "terminal",
      "col": 2,
      "width": 200
    }
  ],
  "transitions": [
    {
      "from": "pass_confirmed",
      "to": "offside_check",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "offside_check",
      "to": "detected",
      "label": "|margin_m| >= review_margin, conf >= c_det",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "from": "offside_check",
      "to": "review_required",
      "label": "|margin_m| < review_margin ou c_review <= conf < c_det",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "from": "offside_check",
      "to": "inconclusive",
      "label": "uma trava dispara, incl. conf < c_review",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left"
    }
  ]
}