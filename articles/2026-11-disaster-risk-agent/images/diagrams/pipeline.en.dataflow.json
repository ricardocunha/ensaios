      "row": 0,
      "width": 124
    },
    {
      "id": "inmet",
      "type": "external",
      "label": "INMET stations",
      "sublabel": "hourly rain",
      "stage": 0,
      "row": 1,
      "width": 124
    },
    {
      "id": "ems",
