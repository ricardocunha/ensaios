.PHONY: install test data data-v1 bid zero-shot train-reader eval-reader report teacher
PY := uv run python -m
MODELS := paddleocr_vl chandra2 qwen35_9b
MODEL ?= paddleocr_vl
# Adapter tag: v1 = round 1 (one design), v2 = round 2 (domain-randomized).
TAG ?= v2
# Synthetic test images per Reader run.
N ?= 50
R := runs/reader

install:            ## deps (incl. mlx + agent extras)
	uv sync --all-extras

test:
	uv run pytest -q

# ---- data -------------------------------------------------------------------

data:               ## Round-2 (v2) and round-3 (v3) sets: same images, v3 always transcribes; ~1 min each
	$(PY) cnh_ocr.synth.build --style v2 --shards 10 --out data/synth-v2 --train 2293 --test 300
	$(PY) cnh_ocr.synth.build --style v3 --shards 10 --out data/synth-v3 --train 2293 --test 300

data-v1:            ## Round-1 set (one design) + hard set; single-process, ~45 min
	$(PY) cnh_ocr.synth.build --out data/synth --train 2293 --validation 300 --test 300
	$(PY) cnh_ocr.synth.build --out data/synth-hard --test 100 --difficulty hard --seed 7

bid:                ## BID sample (real CNH templates; cited, not redistributed) -> data/bid/test
	mkdir -p data/bid-raw && uvx gdown 144EqqmMtCziua9iYo-3afUEvZrJVxUXU -O data/bid-raw/sample.zip
	unzip -q -o data/bid-raw/sample.zip -d data/bid-raw
	$(PY) cnh_ocr.evaluation.bid --bid "data/bid-raw/BID Sample Dataset" --out data/bid

# ---- Stage 1: Reader ----------------------------------------------------------

zero-shot:          ## Every Reader, no fine-tuning, on the synthetic test and BID (free, local)
	for m in $(MODELS); do \
	  $(PY) cnh_ocr.reader.infer --model $$m --data data/synth/test --limit $(N) --out $(R)/$$m-zeroshot.jsonl; \
	  $(PY) cnh_ocr.reader.infer --model $$m --data data/bid/test --out $(R)/bid-$$m-zeroshot.jsonl; \
	done

train-reader:       ## make train-reader [MODEL=paddleocr_vl] [TAG=v2]  (QLORA=--qlora for the 9B models)
	$(PY) cnh_ocr.reader.train_mlx --model $(MODEL) --data $(if $(filter v1,$(TAG)),data/synth,data/synth-$(TAG)) \
	  --out $(R)/$(MODEL)-lora-$(TAG) $(QLORA)

# v3 adapters were trained on the always-transcribe prompt (ADR-0003); earlier ones on v1.
PROMPT = $(if $(filter v3,$(TAG)),v3,v1)
eval-reader:        ## make eval-reader [MODEL=paddleocr_vl] [TAG=v2]: synthetic test, hard set, BID
	$(PY) cnh_ocr.reader.infer --model $(MODEL) --adapter $(R)/$(MODEL)-lora-$(TAG) --prompt $(PROMPT) \
	  --data data/synth/test --limit $(N) --out $(R)/$(MODEL)-lora-$(TAG).jsonl
	$(PY) cnh_ocr.reader.infer --model $(MODEL) --adapter $(R)/$(MODEL)-lora-$(TAG) --prompt $(PROMPT) \
	  --data data/synth-hard/test --out $(R)/hard-$(MODEL)-lora-$(TAG).jsonl
	$(PY) cnh_ocr.reader.infer --model $(MODEL) --adapter $(R)/$(MODEL)-lora-$(TAG) --prompt $(PROMPT) \
	  --data data/bid/test --out $(R)/bid-$(MODEL)-lora-$(TAG).jsonl

# Each set is scored against its own ground truth. File prefixes keep them apart,
# because the hard set reuses the synthetic test's file names.
SYNTH_RUNS := $(foreach m,$(MODELS),$(wildcard $(R)/$(m)-*.jsonl))
report:             ## Results tables -> docs/RESULTS.md
	{ echo "# Results"; echo; echo "Generated by \`make report\`. CNH-only accuracy; rejections reported separately."; echo; \
	  echo "## Synthetic test (round-1 design)"; echo; \
	  $(PY) cnh_ocr.evaluation.report --data data/synth/test --reader $(SYNTH_RUNS) | sed -n '3,$$p' | sed '/^## Extractor/,$$d'; \
	  echo "## Synthetic hard set"; echo; \
	  $(PY) cnh_ocr.evaluation.report --data data/synth-hard/test --reader $(wildcard $(R)/hard-*.jsonl) | sed -n '3,$$p' | sed '/^## Extractor/,$$d'; \
	  echo "## BID (real CNH templates)"; echo; \
	  $(PY) cnh_ocr.evaluation.report --data data/bid/test --reader $(wildcard $(R)/bid-*.jsonl) \
	    --extractor $(wildcard runs/extractor/*.jsonl) | sed -n '3,$$p'; \
	} > docs/RESULTS.md
	@echo "wrote docs/RESULTS.md"

# ---- Stage 2: Extractor + smithtune (PAID) --------------------------------------

# Keys and the LangSmith project (LANGSMITH_PROJECT) come from .env.
teacher:            ## Teacher trajectories -> LangSmith (Anthropic API). Try LIMIT=20 first to see the cost.
	$(PY) cnh_ocr.extractor.run --role teacher --data data/synth-v3/train --limit $(or $(LIMIT),1500)
# smithtune steps: ./smithtune/run.sh <step>  (paid steps ask y/N)
