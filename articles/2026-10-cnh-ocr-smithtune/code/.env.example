# Teacher (Stage 2 trajectories)
ANTHROPIC_API_KEY=
TEACHER_MODEL=claude-sonnet-5

# LangSmith (tracing + smithtune datasets)
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_PROJECT_ID=          # UUID of the cnh-extractor-teacher tracing project
GOLDEN_DATASET_ID=             # optional: read automatically from push-golden's receipt

# smithtune training provider
BASETEN_API_KEY=
SMITHTUNE_PROVIDER=baseten
SMITHTUNE_MODEL=Qwen/Qwen3.5-9B

# Filled after `./smithtune/run.sh deploy`
STUDENT_URL=
STUDENT_MODEL=

# Hugging Face (downloading models, publishing dataset/adapters)
HF_TOKEN=
