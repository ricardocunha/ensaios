# Teacher (Stage 2 trajectories). Must be a model whose license allows training on its outputs.
# Claude models (claude-*) use ANTHROPIC_API_KEY; others run on Baseten Model APIs.
ANTHROPIC_API_KEY=
TEACHER_MODEL=deepseek-ai/DeepSeek-V4-Pro-0813

# LangSmith (tracing + smithtune datasets)
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE_ID=
# UUID of the LangSmith tracing project the Teacher writes to (smithtune pulls from it)
LANGSMITH_PROJECT_ID=
# Name of that project (the Teacher runner traces into it)
LANGSMITH_PROJECT=cnh-teacher-deepseek
# optional: read automatically from push-golden's receipt
GOLDEN_DATASET_ID=

# smithtune training provider
BASETEN_API_KEY=
SMITHTUNE_PROVIDER=baseten
SMITHTUNE_MODEL=Qwen/Qwen3.5-9B

# Filled after `./smithtune/run.sh deploy`
STUDENT_URL=
STUDENT_MODEL=

# Hugging Face (downloading models, publishing dataset/adapters)
HF_TOKEN=
