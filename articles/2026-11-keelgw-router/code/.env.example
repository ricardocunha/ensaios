# Copy to .env (git-ignored). The Makefile and docker compose read it.

# --- the router service (server.py) ---
# PORT=8080                 # port inside the container
# ROUTER_THREADS=2          # ONNX Runtime threads per inference
# ROUTER_CONCURRENCY=1      # inferences at once per process
# ROUTER_QUEUE_MS=1000      # wait for a free slot before answering 503
# ROUTER_METRICS_PORT=0     # also serve /metrics on this port (0: only on PORT)
# ROUTER_MODEL_DIR=.cache/model
# ROUTER_HEAD=model/head.json

# --- host ports for docker compose ---
# ROUTER_HOST_PORT=18080        # the normal router
# ROUTER_TIGHT_HOST_PORT=18081  # router-tight: concurrency 1, 50 ms queue

# --- the single live test (make test-live) ---
# It makes ONE real Anthropic API call, a fraction of a cent. make test-live
# sets KEELGW_ROUTER_LIVE=1 itself; nothing else does. Never commit a key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=~/.config/anthropic/key
# LIVE_LABEL_MODEL=claude-haiku-4-5
