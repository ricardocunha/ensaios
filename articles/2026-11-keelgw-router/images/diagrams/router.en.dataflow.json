      "label": "train + val",
      "variant": "dashed"
    },
    {
      "id": "train-head",
      "from": "train",
      "to": "head",
      "label": "head.json",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "bottom",
      "via": [
        [
          960,
          385
        ]
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Request path",
      "items": [
        "Only the latest user turn is classified",
        "e5 is about 99% of the time; the head is microseconds",
        "p50 7.3 ms, p95 19.4 ms on an M4 Pro"
      ]
    },
    {
      "dot": "rose",
      "title": "Back-pressure",
      "items": [
        "One inference at a time per process",
        "A request that can't get the slot in time gets 503",
        "The caller uses a fallback Tier instead of waiting"
      ]
    },
    {
      "dot": "orange",
      "title": "Offline training",
      "items": [
        "The head is the only trained part",
        "Retrains from the dataset in seconds, no API calls",
        "75.4% on 452 held-out synthetic prompts"
      ]
    }
  ]
}
